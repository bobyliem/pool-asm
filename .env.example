# Port Web Server
PORT=8080

# Database Lokal CSV (MySQL Docker Container)
DB_CSV_HOST=db-csv
DB_CSV_PORT=3306
# Aplikasi konek sebagai user ini, bukan root.
DB_CSV_USER=asm
DB_CSV_PASS=GANTI_PASSWORD_USER_APLIKASI
DB_CSV_NAME=imp_sampurna

# Password root container MySQL. Tidak dipakai aplikasi.
# Harus sama dengan password yang dipakai saat volume MySQL pertama kali dibuat.
DB_ROOT_PASS=GANTI_PASSWORD_ROOT_MYSQL

# Database Head Office (HO Remote MySQL Server)
DB_HO_HOST=10.2.1.2
DB_HO_PORT=3306
DB_HO_USER=GANTI_USER_HO
DB_HO_PASS=GANTI_PASSWORD_HO
DB_HO_NAME=workshop
